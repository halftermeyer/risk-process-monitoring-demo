:"MATCH (n) OPTIONAL MATCH p=(n)--() RETURN p, n LIMIT 100","isUpdateQuery":null,"isWriteTransactionChecked":null,"params":[],"hasCypherErrors":false}],"sceneActions":[{"name":"CPA","id":"926e2170-2475-11f0-b9d1-2151e5c48a8a","createdAt":1745874783496,"cypher":"MATCH (n:Process WHERE elementId(n) IN $nodes)<-[i:IS_INSTANCE_OF]-(j:Job WHERE j.status <> \"Completed\")\nCALL (n, i, j){\n  OPTIONAL MATCH path = (j)(()-[:DEPENDS_ON|WAITS]->(jobs))*(x WHERE x.status <> \"Completed\")\n  WITH n, i, path, apoc.coll.sum([job IN [j]+jobs | job.duration * (1.0-job.completion_progress)]) AS total_duration\n  ORDER BY total_duration DESC LIMIT 1\n  WITH n, i, path, apoc.create.vNode([\"Report\"], {critical_duration: total_duration}) AS info\n  RETURN path, info, apoc.create.vRelationship(n, \"INFO\", {}, info) AS r\n}\nRETURN n, i, path, info, r","isUpdateQuery":null,"isWriteTransactionChecked":null,"categories":[2],"relationshipTypes":null,"hasCypherErrors":false}],"hiddenRelationshipTypes":[],"hideUncategorisedData":false,"type":"STANDARD_PERSPECTIVE","parentPerspectiveId":null,"metadata":{"pathSegments":[{"source":"Job","relationshipType":"WAITS","target":"Job"},{"source":"Processor","relationshipType":"QUEUE_TAIL","target":"Job"},{"source":"Job","relationshipType":"DEPENDS_ON","target":"Job"},{"source":"Job","relationshipType":"RUNS_ON","target":"Processor"},{"source":"Job","relationshipType":"IS_INSTANCE_OF","target":"Process"},{"source":"Processor","relationshipType":"QUEUE_HEAD","target":"Job"}],"indexes":[{"label":null,"type":"native","propertyKeys":[]},{"label":"Report","type":"native","propertyKeys":[{"key":"thing","metadataProp":false}]},{"label":"Processor","type":"native","isMetadataPropIndex":true,"propertyKeys":[{"key":"name","metadataProp":true},{"key":"load","metadataProp":true},{"key":"processor_id","metadataProp":true}]},{"label":"Process","type":"native","isMetadataPropIndex":true,"propertyKeys":[{"key":"name","metadataProp":true},{"key":"process_id","metadat